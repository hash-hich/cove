# What cove requires of any kernel it boots, its own or one the user brings:
# everything without which the init or the disks of a run do not work. The
# list is closed and checked at boot by internal/kernelcheck, which holds it
# and names what is missing; a test holds this fragment to the same check. An
# option other fragments also set is still here: they are checked by no one.

# The read only disks: each layer of the image is one EROFS disk on
# virtio-blk, stacked by overlayfs. The three attribute options carry the
# extended attributes, ACLs and file capabilities a layer holds; without them
# the guest drops them without a word.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
# EROFS sits under the menu of miscellaneous file systems.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
# The blobs are uncompressed: internal/erofs never writes a compressed block,
# and a kernel without EROFS_FS_ZIP reads every blob cove writes.
# CONFIG_EROFS_FS_ZIP is not set
CONFIG_OVERLAY_FS=y

# The write layer and the volumes of an image are ext4 disks cove writes:
# without ext4 no run mounts its upper.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# The turn channel to the host, and the one network card, wired to cove-proxy.
CONFIG_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# At least one transport for the devices above: libkrun and Firecracker attach
# virtio over mmio today, PCI is for the day a backend moves to it. On x86_64
# both declare their mmio devices on the command line.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y

# A console, where the init writes its refusal when the channel to the host is
# not there: libkrun gives a virtio console, Firecracker a serial port, which
# the architecture fragments carry.
CONFIG_TTY=y
CONFIG_VIRTIO_CONSOLE=y

# The init lives in an initramfs, an uncompressed cpio: every RD_ decompressor
# stays off. It finds its disks in /dev and /sys, and reads in /proc the
# configuration the kernel embeds. IKCONFIG_PROC is a requirement of the check
# itself: a kernel without it is refused, though it might have worked.
CONFIG_BLK_DEV_INITRD=y
# The init and the check are Go programs: the kernel must run an ELF, and the
# Go runtime needs futexes, epoll and eventfd before main. Without them the
# init never writes its refusal; the host reads the panic on the console
# instead (kernelcheck.FromConsole).
CONFIG_BINFMT_ELF=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
