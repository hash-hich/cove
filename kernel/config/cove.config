# What cove requires of any kernel it boots, its own or one the user brings.
# The list is closed and checked at boot by internal/kernelcheck, which holds
# it and names what is missing; this fragment is where cove's own kernel meets
# it, and a test keeps the two in step.

# The disks: each layer of the image is one EROFS disk on virtio-blk, stacked
# by overlayfs. The three attribute options carry the extended attributes,
# ACLs and file capabilities a layer holds; without them the guest drops them
# without a word.
CONFIG_VIRTIO_BLK=y
# EROFS sits under the menu of miscellaneous file systems.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_OVERLAY_FS=y

# The turn channel to the host, and the one network card, wired to cove-proxy.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_NET=y

# The init lives in an initramfs, and reads the configuration the kernel
# embeds to check the list above before anything else runs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
