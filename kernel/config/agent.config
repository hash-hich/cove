# What the agent's own sandboxes need, whatever else the kernel carries: a
# kernel without the containers fragment is still a kernel for an agent.
# bubblewrap, which Codex CLI and srt confine their commands with, and the
# sandbox of Chromium build theirs from user, PID and network namespaces and a
# seccomp filter. Landlock is for the sandboxers built on it, Codex CLI before
# it moved to bubblewrap among them; it costs nothing until a process asks.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
# Landlock is the only security module: nothing else enforces a policy in the
# guest, as nothing in it is protected from the agent.
CONFIG_LSM="landlock"
