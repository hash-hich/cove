# The virtual machine of the arm64 backends, read in their device trees:
# libkrun gives a PL011 serial port, Firecracker an ns16550a, both a PL031 RTC
# and a generic PCI host.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# The 8250 of Firecracker is found in the device tree: with console=ttyS the
# list of internal/kernelcheck requires this line on arm64.
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_RTC_DRV_PL031=y
# The clock is read from the PL031 at boot: a guest that starts in 1970 fails
# every TLS handshake on the validity of the certificate.
CONFIG_RTC_HCTOSYS=y

# Pages of 4 KiB, the block size internal/erofs writes: a blob then maps page
# for page, whatever the page size of the host that wrote it.
CONFIG_ARM64_4K_PAGES=y

# The speculative execution mitigations are off, for the reason the base
# fragment gives. The two that cost most have a prompt, and EXPERT leaves them
# off: the unmapping of the kernel at EL0 and the branch history mitigation.
# The rest, Spectre v2 and SSBD through the firmware, cannot be compiled out;
# the backend turns them off with mitigations=off on the command line.

# A guest runs on the real core, and the kernel applies the workaround of an
# erratum when it reads the core's MIDR, but only if it was compiled in: every
# erratum the kernel turns on by default is here. Apple cores need none of
# them; Graviton, Ampere and Cortex cores do.
CONFIG_AMPERE_ERRATUM_AC03_CPU_38=y
CONFIG_AMPERE_ERRATUM_AC04_CPU_23=y
CONFIG_ARM64_ERRATUM_1024718=y
CONFIG_ARM64_ERRATUM_1165522=y
CONFIG_ARM64_ERRATUM_1319367=y
CONFIG_ARM64_ERRATUM_1463225=y
CONFIG_ARM64_ERRATUM_1508412=y
CONFIG_ARM64_ERRATUM_1530923=y
CONFIG_ARM64_ERRATUM_2051678=y
CONFIG_ARM64_ERRATUM_2054223=y
CONFIG_ARM64_ERRATUM_2067961=y
CONFIG_ARM64_ERRATUM_2077057=y
CONFIG_ARM64_ERRATUM_2457168=y
CONFIG_ARM64_ERRATUM_2645198=y
CONFIG_ARM64_ERRATUM_2658417=y
CONFIG_ARM64_ERRATUM_2966298=y
CONFIG_ARM64_ERRATUM_3117295=y
CONFIG_ARM64_ERRATUM_3194386=y
CONFIG_ARM64_ERRATUM_4118414=y
CONFIG_ARM64_ERRATUM_4193714=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_858921=y
CONFIG_CAVIUM_ERRATUM_22375=y
CONFIG_CAVIUM_ERRATUM_23154=y
CONFIG_CAVIUM_ERRATUM_27456=y
CONFIG_CAVIUM_ERRATUM_30115=y
CONFIG_CAVIUM_TX2_ERRATUM_219=y
CONFIG_FSL_ERRATUM_A008585=y
CONFIG_FUJITSU_ERRATUM_010001=y
CONFIG_HISILICON_ERRATUM_161010101=y
CONFIG_HISILICON_ERRATUM_161600802=y
CONFIG_HISILICON_ERRATUM_162100801=y
CONFIG_NVIDIA_CARMEL_CNP_ERRATUM=y
CONFIG_QCOM_FALKOR_ERRATUM_1003=y
CONFIG_QCOM_FALKOR_ERRATUM_1009=y
CONFIG_QCOM_FALKOR_ERRATUM_E1041=y
CONFIG_QCOM_QDF2400_ERRATUM_0065=y
CONFIG_ROCKCHIP_ERRATUM_3568002=y
CONFIG_ROCKCHIP_ERRATUM_3588001=y

# The features of the core userland may use: without them a binary built for
# SVE, SME, pointer authentication, BTI, MTE or the guarded control stack
# fails, or runs without what it asked for.
CONFIG_ARM64_SVE=y
CONFIG_ARM64_SME=y
# Pointer authentication and BTI of userland only: the same protections for the
# kernel would guard it from the agent, which the base fragment decides not
# to do.
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_MTE=y
CONFIG_ARM64_GCS=y
CONFIG_ARM64_POE=y
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_EPAN=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_AMU_EXTN=y
CONFIG_ARM64_RAS_EXTN=y
CONFIG_ARM64_CNP=y
CONFIG_ARM64_TLB_RANGE=y
CONFIG_ARM64_HW_AFDBM=y
CONFIG_ARM64_HAFT=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_USE_LSE_ATOMICS=y
# The event stream wakes a core waiting in WFE, which spin loops of userland
# and of the kernel count on.
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
CONFIG_SCHED_CLUSTER=y
CONFIG_ARM64_CONTPTE=y
# The kernel's defaults for the DMA zones, which a device that addresses fewer
# bits than the machine has needs.
CONFIG_ZONE_DMA=y
CONFIG_ZONE_DMA32=y
CONFIG_RELOCATABLE=y
