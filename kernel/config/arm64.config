# The virt machine of every arm64 VMM: GIC, generic PCI host, PL011 and PL031.

# Pages of 4 KiB, the block size internal/erofs writes: a blob then maps page
# for page, whatever the page size of the host that wrote it.
CONFIG_ARM64_4K_PAGES=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
