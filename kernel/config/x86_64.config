# A KVM guest. The clock comes from kvmclock, which gives the wall time at
# boot: neither libkrun nor Firecracker exposes a CMOS clock on x86_64.
# Firecracker gives an 8250 serial port, in the base fragment, and describes
# its machine with ACPI and an MP table.
CONFIG_64BIT=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_ACPI=y
CONFIG_X86_MPPARSE=y
CONFIG_PCI_MMCONFIG=y
CONFIG_X86_X2APIC=y
CONFIG_X86_MCE=y
# The reason is in the base fragment.
# CONFIG_CPU_MITIGATIONS is not set
# Memory protection keys, which JIT runtimes use when the core has them.
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=y
# The shadow stack of userland, which glibc 2.39 turns on when the kernel
# offers it: the counterpart of ARM64_GCS, so that a program that breaks on it
# breaks on both architectures.
CONFIG_X86_USER_SHADOW_STACK=y
# 32 bit binaries: Wine, old SDK tools, test suites built with -m32, with the
# 16 bit segments and LDT Wine sets up, the 16 bit IDs of old binaries, and
# the vsyscall page old static glibc binaries call.
CONFIG_IA32_EMULATION=y
CONFIG_MODIFY_LDT_SYSCALL=y
CONFIG_X86_16BIT=y
CONFIG_X86_ESPFIX64=y
CONFIG_UID16=y
CONFIG_SGETMASK_SYSCALL=y
CONFIG_X86_VSYSCALL_EMULATION=y
CONFIG_X86_PAT=y
CONFIG_MTRR=y
# Spinlocks that yield to the host when it runs more vCPUs than it has cores.
CONFIG_PARAVIRT_SPINLOCKS=y
# The soft dirty bit CRIU's incremental dumps read; arm64 has none.
CONFIG_MEM_SOFT_DIRTY=y
# Messages of the first instants of boot on the serial port, where a kernel
# that stops before its console says why.
CONFIG_EARLY_PRINTK=y
