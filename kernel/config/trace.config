# eBPF tracing: bpftrace, libbpf tools, and the tracepoints and probes they
# attach to. The image comes from the user and the kernel from cove, so no
# image carries the headers of the running kernel: without BTF no eBPF tool
# works whatever the image, and with it the CO-RE tools need no header at all.
# BTF costs DWARF at build time, pahole in the builder, and a few MiB of .BTF
# resident in the kernel; the DWARF itself is stripped from the x86_64
# vmlinux, and never reaches the raw arm64 Image.
# DEBUG_KERNEL opens the menu of debug information. From allnoconfig it turns
# on two cheap options by itself, DEBUG_BUGVERBOSE and DEBUG_MEMORY_INIT.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_JIT=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
# Older bcc tools look for /sys/kernel/debug/tracing, where debugfs mounts
# tracefs only with the automount the kernel deprecates.
CONFIG_DEBUG_FS=y
CONFIG_TRACEFS_AUTOMOUNT_DEPRECATED=y
