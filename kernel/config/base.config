# A kernel that runs a Linux userland in a virtual machine, on top of
# allnoconfig: every option on in cove's kernel is on because a fragment of
# this directory says so, and a new kernel version turns nothing on behind it.

# Built in, never loadable: the kernel is fixed for the life of the run and
# its identity is the one file the host hands the VMM.
# CONFIG_MODULES is not set
CONFIG_LOCALVERSION="-cove"
# CONFIG_LOCALVERSION_AUTO is not set

# A panic reboots at once, and a VM that reboots ends: the run fails where it
# stands instead of hanging, including when the init dies.
CONFIG_PANIC_TIMEOUT=-1

CONFIG_SMP=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_MULTIUSER=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_KALLSYMS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Both transports: libkrun and Firecracker attach virtio over mmio,
# Virtualization.framework over PCI.
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# The clock is read from the RTC of the VMM at boot: a guest that starts in
# 1970 fails every TLS handshake on the validity of the certificate.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y

CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
# The real file system the write layer and the volumes of an image sit on.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
