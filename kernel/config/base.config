# A kernel that runs a Linux userland in a virtual machine, on top of
# allnoconfig: every option on in cove's kernel is on because a fragment of
# this directory says so, and a new kernel version turns nothing on behind it.
# The price is that an option the kernel turns on by default is off here until
# a line names it; the defaults that are corrections or cheap behaviour
# userland counts on are named below and in the architecture fragments.

# EXPERT gives a prompt to the options that otherwise keep their default
# whatever allnoconfig says (bool "..." if EXPERT, default y): FUTEX, EPOLL,
# COREDUMP, the vsyscall page and a few dozen more. With it they are off unless
# named, and the sentence above holds for them too.
CONFIG_EXPERT=y

# Built in, never loadable: the kernel is fixed for the life of the run and
# its identity is the one file the host hands the VMM.
# CONFIG_MODULES is not set
CONFIG_LOCALVERSION="-cove"
# CONFIG_LOCALVERSION_AUTO is not set

# A panic reboots at once, and a VM that reboots ends, so the run fails where
# it stands. cove never relies on it: a kernel of the user may not do the same,
# and the host bounds every run anyway.
CONFIG_PANIC_TIMEOUT=-1

# Speculative execution mitigations protect the guest kernel from the agent,
# and nothing in the guest is protected from the agent: the boundary is the
# hypervisor. They cost every system call, so they are off: compiled out on
# x86_64, turned off on the command line on arm64, where they cannot be
# compiled out. Stack protection and stacks in vmalloc stay on: they turn a
# silent corruption into a crash that names itself.
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y

CONFIG_SMP=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_MULTIUSER=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_SYMBOLIC_ERRNAME=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_KALLSYMS=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y
CONFIG_ELF_CORE=y
CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS=y
# /proc/PID/smaps and pagemap, which ps, pmap, the JVM and CRIU read.
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_CACHESTAT_SYSCALL=y
CONFIG_SECRETMEM=y
# A BUG names its file and line instead of an address.
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_CRC_OPTIMIZATIONS=y
CONFIG_PCI_QUIRKS=y
# process_vm_readv and process_vm_writev, which gdb and profilers use.
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_SLUB_CPU_PARTIAL=y
# No swap in the guest: memory is the VM's, fixed at its creation. dockerd says
# "No swap limit support" at every start and memory.swap.max does not exist;
# runc does without it.
# CONFIG_SWAP is not set
# Huge pages for the runtimes that ask for them with madvise, the JVM,
# PostgreSQL and Go among them. Never for the others: Redis warns at start
# when they are given to every process.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# virtio over PCI, for the day a backend moves to it; without MSI it falls
# back to one shared legacy interrupt.
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_BALLOON_COMPACTION=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# The clock of the host through KVM, for a guest that runs long enough to
# drift: chrony reads /dev/ptp0.
CONFIG_PTP_1588_CLOCK=y
CONFIG_PTP_1588_CLOCK_KVM=y

CONFIG_RTC_CLASS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_SYSFS=y

CONFIG_PROC_SYSCTL=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FILE_LOCKING=y
CONFIG_DNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_BLK_DEV_WRITE_MOUNTED=y

CONFIG_INET=y
# mDNS, .local names and service discovery join a group. The join succeeds
# without this option, but the kernel then sends no IGMP report and answers
# no query, so a bridge with IGMP snooping, docker0 included, or a network that
# filters by membership never delivers the group.
CONFIG_IP_MULTICAST=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_AF_UNIX_OOB=y
CONFIG_PACKET=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_RPS=y
CONFIG_BQL=y
# ss reads sockets through the diag interfaces, and shows nothing without them.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_VSOCKETS_DIAG=y
