# What the tools of a development workstation ask of the kernel, beyond a
# container engine. Each line is kept for a tool that fails without it; none
# costs anything until something uses it.

# Kubernetes in containers, kind measured, k3d and minikube covered by the
# same lines. kube-proxy in iptables mode tags every rule with a comment,
# spreads a service over its endpoints by a random draw, keeps session
# affinity with recent, and rejects a service without endpoints; in nftables
# mode the draw is numgen. kubeadm checks the hugetlb controller. A
# NetworkPolicy goes through nfqueue in kind and through ipset in k3s, and k3d
# adds VXLAN for flannel. IPVS, which is not the default mode, stays out.
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NFT_NUMGEN=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NFT_QUEUE=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_HUGETLBFS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_VXLAN=y

# Firewall scripts: -m state, which iptables-nft turns into a native
# expression but iptables-legacy needs, -m owner, and a transparent proxy by
# REDIRECT.
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NFT_REDIR=y

# The other network drivers of Docker, and the dummy links of network tests.
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VLAN_8021Q=y

# Traffic control: latency and loss with netem, shaping with htb. Without it
# tc does nothing.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_HTB=y

# Disk images and losetup, FAT and ISO images mounted from a loop device, FUSE
# (sshfs, AppImage, fuse-overlayfs, rootless podman), images of another
# architecture through qemu-user (docker buildx --platform), and TUN for
# slirp4netns, pasta and VPN clients.
CONFIG_BLK_DEV_LOOP=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# utf8=1, which udisks and most scripts pass.
CONFIG_NLS_UTF8=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_FUSE_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_TUN=y
# The automount units of systemd, binfmt_misc among them, for an image booted
# as a real machine; systemd also needs the cgroups of the containers
# fragment.
CONFIG_AUTOFS_FS=y

# What measurement tools read: /proc/PID/io for iotop and pidstat -d, and
# /proc/pressure.
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_PSI=y

# CRIU and docker checkpoint: criu check also reads sockets through the
# netlink and packet diag interfaces. The soft dirty bit is x86_64 only.
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_USERFAULTFD=y
CONFIG_NETLINK_DIAG=y
CONFIG_PACKET_DIAG=y

# perf, on software events only: see the limits in README.md.
CONFIG_PERF_EVENTS=y
