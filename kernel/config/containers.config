# What a container engine run by the agent needs, dockerd and runc measured
# first. cove checks none of it: what the kernel compiles is permitted, and the
# engine comes from the image and says itself what it misses.

# The namespaces and seccomp are in the agent fragment, which needs them
# first. Here: the time namespace, and cgroup v2 with the controllers runc
# delegates, cpu, cpuset, memory, pids and io, which throttling makes enforce
# io.max. The devices of a container are filtered by an eBPF program runc
# attaches, and the freezer is in the core of cgroup v2: the v1 controllers
# for both have no use here.
CONFIG_TIME_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

CONFIG_KEYS=y

# The default bridge network: a veth per container on a bridge, NAT out.
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
# dockerd clears the conntrack entries of a stopped container over netlink;
# without it a stale entry can send UDP to the container that replaced it.
CONFIG_NF_CT_NETLINK=y

# The rules dockerd writes through iptables-nft, the default of current
# distributions and of the docker:dind image.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
# The IPv6 half of xt_addrtype compiles under IP6_NF_IPTABLES alone: without
# it dockerd cannot set up its IPv6 chains.
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y

# The expressions of the native nftables backend of dockerd
# (--firewall-backend=nftables), which the compat path never asks for.
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y

# The tables of iptables-legacy, for images whose iptables has no nft variant
# and tools that call the legacy binary by name. raw is not optional: dockerd
# writes its filter of direct access to container addresses there. The kernel deprecates them
# without a date; they cost a few tens of KiB and nothing until a rule uses
# them, and the matches and targets above are shared with the compat path.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
